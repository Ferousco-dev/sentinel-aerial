# Sentinel environment configuration.
#
# HOW TO USE:
#   1. Copy this file to `.env`   ->   cp .env.example .env
#   2. Fill in the values below.
#   3. `.env` is gitignored, so your keys are NEVER committed.
#   4. start.sh loads `.env` automatically; or `export` these yourself.
#
# Leave a value blank to keep that feature disabled.

# ---------------------------------------------------------------------------
# Dashboard (Phase 5)
# ---------------------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# Optional shared token to gate dashboard access (Phase 6 / issue T10).
DASHBOARD_TOKEN=

# ---------------------------------------------------------------------------
# Telegram alerts (Phase 6 / issue T13)  <-- PUT YOUR TELEGRAM KEYS HERE
# ---------------------------------------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the HTTP API token.
# 2. Message your new bot once, then visit
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "chat":{"id":...} value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# AI Analyst (Phase M8 / issue #38)  <-- Gemini API key for NL situation reports
# ---------------------------------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
